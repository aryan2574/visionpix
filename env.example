# ----------------------------
# Backend app
# ----------------------------

PORT=3000

# CORS / frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------
# Postgres / Prisma
# ----------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=visionpix_dev

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# ----------------------------
# Redis / BullMQ
# ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------
# AWS / S3 / Rekognition
# ----------------------------
AWS_REGION=eu-north-1
AWS_REKOGNITION_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=visionpix-uploads
S3_URL_EXPIRATION_SECONDS=300

# ----------------------------
# Default user (single-user mode)
# ----------------------------
DEFAULT_USER_NAME=VisionPix User
DEFAULT_USER_EMAIL=user@visionpix.local
DEFAULT_USER_PASSWORD=visionpix-single-user

# ----------------------------
# Upload constraints
# ----------------------------
MAX_FILES=5
MAX_FILE_SIZE_BYTES=524288000

# ----------------------------
# Frontend → Backend URL
# ----------------------------
VITE_BACKEND_URL=http://localhost:3000/graphql